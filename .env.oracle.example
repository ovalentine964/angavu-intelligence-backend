# =============================================================================
# Angavu Intelligence Backend — Oracle Cloud Free Tier Environment
# Copy to .env.oracle and fill in all values before deploying.
#
# Deploy: docker compose -f docker-compose.oracle.yml --env-file .env.oracle up -d
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_32_BYTE_RANDOM_SECRET_HERE
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_ENCRYPTION_KEY_HERE

# ── External LLM APIs (optional — for cloud fallback) ───────────────────────
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ── ClickHouse (disabled on Oracle Free Tier to save RAM) ───────────────────
# Not used in oracle compose — analytics go to PostgreSQL
