# =============================================================================
# Angavu Intelligence Backend — Environment Variables
# Copy to .env and fill in production values
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=change-me-to-exactly-32-bytes!!

# ── LLM API Keys ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key

# ── Server ────────────────────────────────────────────────────────────────────
RUST_LOG=info
ANGAVU_HOST=0.0.0.0
ANGAVU_PORT=8000

# ── GitHub Actions (set in repo secrets, not here) ────────────────────────────
# DEPLOY_HOST=your-oracle-cloud-ip
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=<private key>
