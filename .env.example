# =============================================================================
# Angavu Intelligence Backend — Environment Variables
# Copy to .env and fill in production values
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-strong-clickhouse-password

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: These MUST be set to strong random values in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=change-me-to-exactly-32-bytes!!

# ── LLM API Keys ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key

# ── M-Pesa (Safaricom) ────────────────────────────────────────────────────────
# Get from https://developer.safaricom.co.ke
MPESA_PASSKEY=your-lipa-na-mpesa-online-passkey
MPESA_SHORTCODE=174379
MPESA_INITIATOR_PASSWORD=
MPESA_ENVIRONMENT=sandbox

# ── Webhook Security ──────────────────────────────────────────────────────────
# Comma-separated API keys for webhook authentication
WEBHOOK_API_KEYS=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (empty = localhost only)
ALLOWED_ORIGINS=

# ── Server ────────────────────────────────────────────────────────────────────
RUST_LOG=info
ANGAVU_HOST=0.0.0.0
ANGAVU_PORT=8000

# ── OpenTelemetry (optional) ───────────────────────────────────────────────────
# Set to your OTLP collector endpoint to enable distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── GitHub Actions (set in repo secrets, not here) ────────────────────────────
# DEPLOY_HOST=your-oracle-cloud-ip
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=<private key>
